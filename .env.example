# ── App ────────────────────────────────────────────────
NODE_ENV=development
# Public URL Omnidim cloud uses to call /api/integrations/omnidim/* during voice/web calls.
# localhost works for curl tests only — for web calls use ngrok or Cloudflare Tunnel:
#   ngrok http 3000
#   APP_BASE_URL=https://xxxx.ngrok-free.app
APP_BASE_URL=http://localhost:3000
APP_SECRET=change-me-in-production

# ── Database (MySQL / MariaDB) ─────────────────────────
#
# Local dev (XAMPP on macOS):
#   1. Start MySQL from the XAMPP control panel
#   2. Create database: CREATE DATABASE cherry_voice_ai;
#   3. Use the settings below
#
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cherry_voice_ai
DB_CONNECTION_LIMIT=10

# Remote (Hostinger production / shared hosting):
#   - Enable "Remote MySQL" in Hostinger hPanel
#   - Whitelist your public IP address
#   - Uncomment and fill in the remote block (comment out local block above)
#
# DB_HOST_REMOTE=your_hostinger_db_host
# DB_PORT_REMOTE=3306
# DB_USER_REMOTE=your_remote_db_user
# DB_PASSWORD_REMOTE=your_remote_db_password
# DB_NAME_REMOTE=your_remote_db_name
#
# Example active remote override (copy values into DB_* vars):
# DB_HOST=82.25.121.184
# DB_PORT=3306
# DB_USER=u262009927_cherry_ai_omni
# DB_PASSWORD=your_remote_password
# DB_NAME=u262009927_cherry_ai_omni

# ── OmniDimension ──────────────────────────────────────
OMNIDIM_API_KEY=your_api_key_here
# Shared secret to verify inbound Omnidim webhooks (HMAC-SHA256 of raw body).
OMNIDIM_WEBHOOK_SECRET=

# ── Google Gemini (optional) ───────────────────────────
# Used for menu image OCR, PDF text extraction, and website summarization
# when structured data is needed beyond Omnidim knowledge-base PDF ingestion.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
